# Copy to /opt/geolead/.env on the VPS and fill in real values.
# Fastest way to get the secrets: on a machine logged into Heroku, run
#   heroku config -s -a geolead-ai-api > heroku.env
# then scp heroku.env to the server and merge the secret values below.
# NOTE: DATABASE_URL and REDIS_URL are intentionally NOT set here — the compose
# file sets them to the internal container hostnames and they must win. Do not
# copy Heroku's DATABASE_URL/REDIS_URL into this file.

# --- Postgres (compose uses this for the container + the internal DATABASE_URL)
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- Core
CORS_ORIGIN=https://www.geolead.tech
FRONTEND_URL=https://www.geolead.tech
OUTBOUND_BASE_URL=https://api.geolead.tech
OUTBOUND_ADMIN_EMAIL=
OUTBOUND_PHYSICAL_ADDRESS=
JWT_SECRET=
OUTBOUND_SECRET_KEY=
SECRET_ENCRYPTION_KEY=

# --- Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_WEBHOOK_SECRET=
MAILGUN_WEBHOOK_SIGNING_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=

# --- Search / enrichment
SERPER_API_KEY=
SERPER_API_KEY_1=
SERPER_API_KEY_2=
SERPER_API_KEY_3=
WHOISXML_API_KEY=
WHOISFREAKS_KEY=
CRAWLER_BASE_URL=

# --- AI providers
OPENAI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_API_KEY=

# --- Billing
PADDLE_ENV=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER_ID=
PADDLE_PRICE_PRO_ID=
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=
CRYPTO_ACCESS_DAYS=

# --- Admin seed / misc
ADMIN_EMAILS=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
WATCHLIST_REMINDER_EMAIL=
SMTP_REJECT_UNAUTHORIZED=
PER_BUSINESS_ENRICH_TIMEOUT_MS=
ENRICH_CONCURRENCY=
MAX_CONCURRENT_SEARCHES=
