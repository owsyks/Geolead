# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore. Built-in defaults already exclude
# node_modules/, .git/, dist/, build/, obj/, *.lock, *.min.js, etc.

# --- Dependencies / build outputs ---
**/node_modules/
**/dist/
**/.next/
backend/dist/

# --- Exact duplicates (zero information, pure cost) ---
# Full duplicate of the entire repo (a git worktree):
.claude/
# Byte-identical duplicate of "Design Front End UI_UX/":
design_extracted/

# --- Logs / archives / scratch ---
*.log
*.zip
*.make
"New folder/"
idea/

# --- Env files (secrets) ---
.env
.env.*
!.env.example
