{
  "name": "geolead-ai-backend",
  "version": "1.0.0",
  "description": "Backend scraping and lead scoring engine for GeoLead AI",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:watch": "tsx watch src/server.ts",
    "worker": "tsx watch src/workers/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test:security": "tsx --test tests/security.test.ts",
    "audit:tenants": "tsx src/scripts/auditTenantIsolation.ts"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@prisma/client": "^5.10.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.1.5",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^8.2.0",
    "imapflow": "^1.4.7",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.14"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/imapflow": "^1.0.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.11.24",
    "prisma": "^5.10.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "form-data": "4.0.6",
    "undici": "7.28.0"
  }
}
