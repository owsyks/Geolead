# Server Config
PORT=5000
CORS_ORIGIN="http://localhost:3000"

# Database Config (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/geolead_ai?schema=public"

# Redis Config (BullMQ)
REDIS_URL="redis://localhost:6379"

# External API Keys
SERPER_API_KEY=""

# AI — tried in this order (see backend/src/services/aiProvider.ts), each an
# OpenAI-chat-completions-compatible endpoint. All are optional per-provider;
# any call falls through to the next configured one, then to local
# templates/heuristics if none are set. Per-user overrides also live in
# Settings → AI (DB value wins over these env vars).
NVIDIA_API_KEY=""
NVIDIA_MODEL="moonshotai/kimi-k2.6"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
OPENCODE_API_KEY=""
OPENCODE_MODEL="deepseek-v4-flash-free"
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="gemma-4-31b"
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemma-4-31b-it:free"

# Outbound Email Automation
OUTBOUND_BASE_URL="http://localhost:5000"
OUTBOUND_ADMIN_EMAIL="admin@geoleadai.local"
OUTBOUND_PHYSICAL_ADDRESS="GeoLead AI, 123 Market St, Austin, TX 78701"
OUTBOUND_SECRET_KEY="replace-with-a-long-random-secret"
# Dedicated AES-256-GCM root key for provider credentials. Use 32+ random bytes
# from a secret manager; never reuse DATABASE_URL or JWT_SECRET.
SECRET_ENCRYPTION_KEY="replace-with-a-distinct-long-random-secret"
OUTBOUND_QUEUE_INTERVAL_MS=30000
OUTBOUND_QUEUE_MODE="database"

# Auth / transactional email (system-level Resend used for verify + reset emails)
JWT_SECRET="replace-with-a-long-random-secret"
FRONTEND_URL="http://localhost:3000"
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
RESEND_INBOUND_WEBHOOK_SECRET=""
MAILGUN_WEBHOOK_SIGNING_KEY=""
SENDGRID_WEBHOOK_PUBLIC_KEY=""
RESEND_FROM_EMAIL="no-reply@geoleadai.local"
RESEND_FROM_NAME="GeoLead AI"
# One-time admin seed (claims pre-existing single-user data on first boot)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME="Admin"
# Platform admins — comma-separated emails granted the /admin panel. Falls back
# to SEED_ADMIN_EMAIL if unset. These accounts see & manage ALL tenants.
ADMIN_EMAILS=""

# Billing — Paymento one-time crypto payments. Configure the store IPN URL as
# https://YOUR_API_HOST/api/billing/webhook/paymento. Keep both secrets server-only.
PAYMENTO_API_BASE="https://api.paymento.io"
PAYMENTO_API_KEY=""
PAYMENTO_IPN_SECRET=""

CRYPTO_ACCESS_DAYS=30
