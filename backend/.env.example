# Server Config
PORT=5000
CORS_ORIGIN="http://localhost:3000"

# Database Config (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/geolead_ai?schema=public"

# Redis Config (BullMQ)
REDIS_URL="redis://localhost:6379"

# External API Keys
SERPER_API_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Outbound Email Automation
OUTBOUND_BASE_URL="http://localhost:5000"
OUTBOUND_ADMIN_EMAIL="admin@geoleadai.local"
OUTBOUND_PHYSICAL_ADDRESS="GeoLead AI, 123 Market St, Austin, TX 78701"
OUTBOUND_SECRET_KEY="replace-with-a-long-random-secret"
OUTBOUND_QUEUE_INTERVAL_MS=30000
OUTBOUND_QUEUE_MODE="database"

# Auth / transactional email (system-level Resend used for verify + reset emails)
JWT_SECRET="replace-with-a-long-random-secret"
FRONTEND_URL="http://localhost:3000"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@geoleadai.local"
RESEND_FROM_NAME="GeoLead AI"
# One-time admin seed (claims pre-existing single-user data on first boot)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME="Admin"

# Billing — cards via Paddle Billing. Create a Product + two recurring Prices
# (Starter, Pro) in the Paddle dashboard and put their price ids here. Set a
# default payment link under Checkout settings so hosted checkout URLs work.
# PADDLE_ENV = sandbox | live. PADDLE_WEBHOOK_SECRET is the notification secret.
PADDLE_ENV="sandbox"
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_PRICE_STARTER_ID=""
PADDLE_PRICE_PRO_ID=""

# Billing — crypto via Coinbase Commerce (one-time payment = CRYPTO_ACCESS_DAYS
# of the tier). Create an API key + a webhook (shared secret) in Coinbase Commerce.
COINBASE_COMMERCE_API_KEY=""
COINBASE_COMMERCE_WEBHOOK_SECRET=""
CRYPTO_ACCESS_DAYS=30
