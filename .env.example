# Server Config
PORT=5000
CORS_ORIGIN="http://localhost:3000"

# Database Config (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/geolead_ai?schema=public"

# Redis Config (BullMQ)
REDIS_URL="redis://localhost:6379"

# External API Keys
SERPER_API_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Outbound Email Automation
OUTBOUND_BASE_URL="http://localhost:5000"
OUTBOUND_ADMIN_EMAIL="admin@geoleadai.local"
OUTBOUND_PHYSICAL_ADDRESS="GeoLead AI, 123 Market St, Austin, TX 78701"
OUTBOUND_SECRET_KEY="replace-with-a-long-random-secret"
OUTBOUND_QUEUE_INTERVAL_MS=30000
OUTBOUND_QUEUE_MODE="database"
